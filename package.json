{
  "name": "search",
  "version": "0.4.9",
  "repository": "https://github.com/Dieod1598741/search",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "build:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "asar": false,
    "appId": "com.search.app",
    "productName": "SEARCH",
    "artifactName": "SEARCH_Setup.exe",
    "win": {
      "target": "nsis",
      "executableName": "SearchSolution"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      ".next/**/*",
      "public/**/*",
      "prisma/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "playwright": "^1.61.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "dotenv": "^17.4.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
